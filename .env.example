# mado environment. For production copy to ops/.env and pass --env-file ops/.env to docker compose.
# Dev works without any of this: every value below has a localhost default when NODE_ENV != production.
# Generate secrets with: openssl rand -hex 32   (keep passwords URL-safe, they go into connection URLs)

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public origin behind the Cloudflare Tunnel. OAuth metadata, MCP URL, share and invite links use it.
PUBLIC_URL=https://mado.example.ch
PORT=4100
# 32+ chars. Encrypts secrets at rest (OpenRouter key, webhook secrets, share tokens).
# Changing it makes stored secrets unreadable.
MADO_SECRET_KEY=
# Scheduled jobs (pg-boss): nightly trash purge, session/OAuth cleanup. "off" skips pg-boss entirely.
JOBS=on

# ── Database ─────────────────────────────────────────────────────────────
# Compose builds the three URLs below from these passwords; set the URLs yourself only outside compose.
POSTGRES_PASSWORD=
MADO_APP_PASSWORD=
MADO_PURGE_PASSWORD=
# Owner role: runs migrations on start (ops/entrypoint.sh). Unset = skip migrations.
# DATABASE_OWNER_URL=postgres://mado_owner:<POSTGRES_PASSWORD>@postgres:5432/mado
# App role: no DELETE on core tables, so a bug can't hard delete.
# DATABASE_URL=postgres://mado_app:<MADO_APP_PASSWORD>@postgres:5432/mado
# Purge role: the only one with DELETE; used by the trash purge only.
# DATABASE_PURGE_URL=postgres://mado_purge:<MADO_PURGE_PASSWORD>@postgres:5432/mado

# ── Dev only ─────────────────────────────────────────────────────────────
# Vite dev server; in dev the API redirects SPA routes there. Defaults to http://localhost:5173.
# WEB_DEV_URL=http://localhost:5173
# Built SPA served by the API. The Docker image sets /app/apps/web/dist.
# WEB_DIST=/app/apps/web/dist

# ── Backups (ops/backup.sh, ops/restore-test.sh; read from the shell, not by the app) ──
# BACKUP_DIR=/mnt/backup/mado
# RCLONE_REMOTE=r2:mado-backups
# KEEP_DAILY=14
# KEEP_WEEKLY=8
