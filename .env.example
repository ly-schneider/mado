# mado environment. For production copy to ops/.env; docker compose in ops/ reads it automatically.
# Dev works without any of this: every value below has a localhost default when NODE_ENV != production.
# Generate secrets with: openssl rand -hex 32   (keep passwords URL-safe, they go into connection URLs)

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Public origin behind your reverse proxy. OAuth metadata, MCP URL, share and invite links use it.
PUBLIC_URL=https://mado.example.com
PORT=4100
# 32+ chars. Encrypts secrets at rest (OpenRouter key, webhook secrets, share tokens).
# Changing it makes stored secrets unreadable.
MADO_SECRET_KEY=
# Scheduled jobs (pg-boss): nightly trash purge, session/OAuth cleanup. "off" skips pg-boss entirely.
JOBS=on
# Image tag to pull: latest, a release like 0.1.0, or main for the newest build.
# MADO_VERSION=latest
# Where the API listens on the host. Default is loopback only, for a reverse proxy on the same machine.
# MADO_BIND=127.0.0.1:4100

# ── Database ─────────────────────────────────────────────────────────────
# Compose builds the three URLs below from these passwords; set the URLs yourself only outside compose.
POSTGRES_PASSWORD=
MADO_APP_PASSWORD=
MADO_PURGE_PASSWORD=
# Owner role: runs migrations on start (ops/entrypoint.sh). Unset = skip migrations.
# DATABASE_OWNER_URL=postgres://mado_owner:<POSTGRES_PASSWORD>@postgres:5432/mado
# App role: no DELETE on core tables, so a bug can't hard delete.
# DATABASE_URL=postgres://mado_app:<MADO_APP_PASSWORD>@postgres:5432/mado
# Purge role: the only one with DELETE; used by the trash purge only.
# DATABASE_PURGE_URL=postgres://mado_purge:<MADO_PURGE_PASSWORD>@postgres:5432/mado

# ── Dev only ─────────────────────────────────────────────────────────────
# Vite dev server; in dev the API redirects SPA routes there. Defaults to http://localhost:5173.
# WEB_DEV_URL=http://localhost:5173
# Built SPA served by the API. The Docker image sets /app/apps/web/dist.
# WEB_DIST=/app/apps/web/dist

# ── Backups (backup sidecar in ops/docker-compose.yml) ───────────────────
# Cron schedules in the container's TZ. RESTORE_TEST_SCHEDULE=off disables the monthly restore test.
# BACKUP_SCHEDULE=15 2 * * *
# RESTORE_TEST_SCHEDULE=0 4 1 * *
# TZ=Europe/Zurich
# KEEP_DAILY=14
# KEEP_WEEKLY=8
# Host path for dumps (e.g. a second disk). Default: the "backups" Docker volume.
# BACKUP_DIR=/mnt/backup/mado
# Run one backup when the container starts.
# BACKUP_ON_START=false
# Offsite copy: any rclone remote, configured with rclone's own env vars. Unset = local only.
# Example for an S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS, MinIO):
# BACKUP_REMOTE=offsite:mado-backups
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
