{
  "name": "mado",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate",
    "db:seed": "bun run --cwd packages/db seed",
    "db:seed:reset": "bun run --cwd packages/db seed:reset",
    "db:up": "docker compose -f ops/docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~7.0.2",
    "@types/bun": "latest"
  }
}
