{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SPA glue: events from the native menu, deep links and the capture window, and opening web links in the default browser.",
  "windows": [
    "main",
    "capture"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-toggle-maximize",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
